# From @BotFather
BOT_TOKEN=123456:ABC...
# Public HTTPS base URL (mini app + webhook). Leave empty locally to use long polling.
PUBLIC_URL=https://your-app.fly.dev
# Short name you registered with BotFather /newapp (used for the t.me/<bot>/<app> link)
WEBAPP_SHORT_NAME=app
# Group whose admins may use the mini app (get it from the bot log after adding it to the group)
GROUP_CHAT_ID=-1001234567890
# Your Telegram user id (ask @userinfobot). The owner is always an admin and is the only one who can add admins.
OWNER_ID=
# Random string; protects the webhook path
WEBHOOK_SECRET=change-me
# Time zone for the date in poll questions
TIMEZONE=Asia/Seoul
DB_PATH=./data/app.db
PORT=8080
